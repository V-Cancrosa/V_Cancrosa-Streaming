/* -------------------------------------------------------------------------
 * Vincent-Media – motyw wyglądu OBS Studio (wariant Yami, OBS 30.2+).
 * Kolory serwisu Vincent-Media: grafit, fiolet #7c5cff, cyjan #00e1ff, czerwone „na żywo”.
 * Instaluje go kreator startu (program Vincent-Media) do %APPDATA%\obs-studio\themes
 * i raz wybiera w OBS (Ustawienia → Wygląd → Motyw: Vincent-Media). Zmienisz go tam w każdej chwili.
 * System motywów OBS: https://github.com/obsproject/obs-studio/wiki/OBS-Studio-Theme-System
 * ------------------------------------------------------------------------- */

@OBSThemeMeta {
    name: 'Vincent-Media';
    id: 'com.obsproject.Yami.VincentMedia';
    extends: 'com.obsproject.Yami';
    author: 'Vincent-Media';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: rgb(107,111,126);
    --grey2: rgb(74,78,92);
    --grey3: rgb(52,56,68);
    --grey4: rgb(42,45,56);
    --grey5: rgb(34,37,47);
    --grey6: rgb(23,25,32);
    --grey7: rgb(18,19,26);
    --grey8: rgb(11,12,16);

    --white1: rgb(242,243,247);
    --white5: rgb(158,161,173);

    --primary: rgb(124,92,255);
    --primary_light: rgb(148,121,255);
    --primary_lighter: rgb(173,151,255);
    --primary_dark: rgb(91,63,217);
    --primary_darker: rgb(62,42,153);

    --bg_window: var(--grey7);
    --bg_base: var(--grey6);
    --bg_preview: rgb(8,8,11);

    --text: var(--white1);
    --text_light: var(--white1);
    --text_muted: var(--white5);

    --highlight_color: rgb(0,225,255);

    --border_radius: 6px;
    --border_radius_small: 4px;
    --border_radius_large: 10px;

    --border_color: var(--grey4);

    --input_bg: var(--grey5);
    --input_bg_hover: var(--grey4);
    --input_bg_focus: var(--grey8);
    --input_border: var(--grey4);
    --input_border_hover: var(--grey3);
    --input_border_focus: var(--primary);

    --list_item_bg_selected: var(--primary_dark);
    --list_item_bg_hover: var(--grey4);

    --button_bg: var(--grey5);
    --button_bg_hover: var(--grey4);
    --button_bg_down: var(--primary_darker);
    --button_bg_disabled: var(--grey6);
    --button_border: var(--grey4);
    --button_border_hover: var(--primary);
    --button_border_focus: var(--primary);

    /* „na żywo” – jak w kokpicie */
    --button_bg_red: rgb(233,25,22);
    --button_bg_red_hover: rgb(250,58,55);
    --button_bg_red_down: rgb(170,18,16);

    --tab_bg: var(--grey6);
    --tab_bg_hover: var(--grey5);
    --tab_bg_down: var(--primary_darker);
    --tab_border_hover: var(--primary_light);
    --tab_border_focus: var(--primary);
    --tab_border_selected: var(--primary);

    --scrollbar_handle: var(--grey3);
    --scrollbar_hover: var(--primary);
    --scrollbar_down: var(--primary_dark);
    --scrollbar_border: var(--grey6);

    --toggle_handle: var(--white1);
}

QDockWidget::title {
    background-color: var(--grey6);
    border-bottom: 1px solid var(--grey4);
}

QMenu::separator {
    background-color: var(--grey4);
}

QPushButton:disabled {
    border-color: var(--grey5);
}

QHeaderView::section {
    background-color: var(--grey5);
}

OBSQTDisplay {
    qproperty-displayBackgroundColor: rgb(8,8,11);
}

/* Start transmisji i nagrywania: fioletowe w spoczynku, czerwone, gdy trwają */
#streamButton:!hover:!pressed.state-active,
#recordButton:!hover:!pressed.state-active,
#pauseRecordButton:!hover:!pressed.state-active,
#replayBufferButton:!hover:!pressed.state-active,
#virtualCamButton:!hover:!pressed.state-active,
#broadcastButton:!hover:!pressed.state-active {
    background: var(--button_bg_red);
    border-color: var(--button_bg_red);
}

#streamButton:hover:!pressed.state-active,
#recordButton:hover:!pressed.state-active,
#pauseRecordButton:hover:!pressed.state-active,
#replayBufferButton:hover:!pressed.state-active,
#virtualCamButton:hover:!pressed.state-active,
#broadcastButton:hover:!pressed.state-active {
    background: var(--button_bg_red_hover);
}

#streamButton:pressed.state-active,
#recordButton:pressed.state-active,
#pauseRecordButton:pressed.state-active,
#replayBufferButton:pressed.state-active,
#virtualCamButton:pressed.state-active,
#broadcastButton:pressed.state-active {
    background: var(--button_bg_red_down);
}

/* sceny i źródła: zaznaczenie w kolorze Vincent-Media */
.list-grid SceneTree::item:selected,
.list-grid SceneTree::item:checked {
    background-color: var(--primary_dark);
}

.list-grid SceneTree::item:hover {
    background-color: var(--grey4);
}

SourceSelectButton QPushButton:checked {
    background: var(--primary_dark);
    border-color: var(--primary);
}

idian--ToggleSwitch {
    qproperty-background_checked: var(--primary);
    qproperty-background_checked_hover: var(--primary_light);
}
